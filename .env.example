PORT=3000
# Required to POST service records (workshops). Leave empty to disable writes' auth (dev only).
WRITE_TOKEN=change-me
# Optional paid history provider. {vin} is replaced with the VIN.
# HISTORY_API_URL=https://api.example.com/v1/history?vin={vin}
# HISTORY_API_KEY=
# HISTORY_API_NAME=my-provider

# Needed for reading spec-plate photos (sent to the Anthropic API, not stored)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Licensed insurance / accident sources ({vin} is replaced). Expected JSON:
#   insurance: {"status":"active|expired|none","insurer":"..","policyType":"..","expiry":"YYYY-MM-DD"}
#   accidents: [{"date":"YYYY-MM-DD","severity":"minor|major","totalLoss":false,"description":"..","source":".."}]
# INSURANCE_API_URL=https://partner.example/insurance?vin={vin}
# INSURANCE_API_KEY=
# ACCIDENTS_API_URL=https://partner.example/accidents?vin={vin}
# ACCIDENTS_API_KEY=
